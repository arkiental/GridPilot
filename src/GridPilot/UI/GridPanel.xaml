<Window x:Class="GridPilot.UI.GridPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GridPilot.UI"
 Title="GridPilot — arrange window" Width="1020" Height="668" WindowStyle="None" ResizeMode="NoResize" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" ShowInTaskbar="False" Topmost="True">
 <Window.Resources>
  <ControlTemplate x:Key="WindowCardTemplate" TargetType="Button"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="17"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,12"/><Setter Property="Margin" Value="6,3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid><ContentPresenter HorizontalAlignment="Center"/><Border x:Name="Underline" Height="2" Background="Transparent" VerticalAlignment="Bottom" Margin="0,0,0,-7"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CellBrush}"/><Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
 <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="SidebarColumn" Width="300"/></Grid.ColumnDefinitions>
 <Border Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12,0,0,12" Padding="10,12,10,8">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0">
    <DockPanel Margin="8,0,2,7" Height="30">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button x:Name="SidebarToggle" Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="Show or hide windows (Ctrl+F to search)" AutomationProperties.Name="Show or hide window sidebar" Click="ToggleSidebarClick" Margin="0,0,8,0"/>
      <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Undo placement (Ctrl+Z)" AutomationProperties.Name="Undo placement" Click="UndoClick"/>
      <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" Click="SettingsClick" Margin="8,0"/>
      <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Cancel (Escape)" AutomationProperties.Name="Cancel placement" Click="CancelClick"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Path Fill="{DynamicResource AccentBrush}" Width="21" Height="21" Stretch="Fill" Data="M0,0 H8 V8 H0 Z M11,0 H19 V8 H11 Z M0,11 H8 V19 H0 Z M11,11 H19 V19 H11 Z"/>
      <TextBlock Text="GridPilot" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"/>
     </StackPanel>
    </DockPanel>
    <DockPanel Margin="8,2,8,8" Height="33">
     <Button x:Name="WindowStackButton" DockPanel.Dock="Right" Content="Overlapping windows ⌄" Visibility="Collapsed" FontSize="11" Padding="9,4" Margin="8,0,0,0" Click="WindowStackClick" AutomationProperties.Name="Choose overlapping window" ToolTip="Choose a window beneath this point. Ctrl-click again cycles forward; Ctrl+Shift-click cycles backward."/>
     <Image x:Name="TargetIcon" DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
     <TextBlock x:Name="TargetTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Background="{DynamicResource PanelControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,7" Padding="2,0">
     <DockPanel Height="32">
      <Button Background="Transparent" DockPanel.Dock="Right" Content="Auto arrange" Click="AutoArrangeClick" Padding="10,4" BorderThickness="0" ToolTip="Preview and arrange windows on this display"/>
      <Button x:Name="GridOptionsButton" Background="Transparent" DockPanel.Dock="Right" Click="GridOptionsClick" BorderThickness="0" Padding="12,4" ToolTip="Grid size" AutomationProperties.Name="Grid size"><StackPanel Orientation="Horizontal"><TextBlock x:Name="GridSize"/><TextBlock Text="⌄" Margin="12,0,0,0"/></StackPanel></Button>
      <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
      <ComboBox x:Name="MonitorPicker" Background="Transparent" AutomationProperties.Name="Destination display" DisplayMemberPath="ShortLabel" SelectionChanged="MonitorChanged" MinHeight="28" BorderBrush="Transparent" Margin="0,0,10,0"/>
     </DockPanel>
    </Border>
   </StackPanel>
   <local:SelectionGrid Grid.Row="1" x:Name="GridControl" AutomationProperties.Name="Desktop placement preview" ToolTip="Drag to place. Ctrl-click selects a window; repeat to cycle overlaps. Ctrl+Shift-click cycles backward. Red is the selected window; orange is its destination."/>
   <UniformGrid Grid.Row="2" Rows="1" Columns="5" Margin="14,8,14,2" Height="86">
    <Button Style="{StaticResource PresetButton}" Click="LeftClick" AutomationProperties.Name="Place left half"><StackPanel><local:LayoutGlyph Kind="Left"/><TextBlock Text="Left" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/></StackPanel></Button>
    <Button Style="{StaticResource PresetButton}" Click="RightClick" AutomationProperties.Name="Place right half"><StackPanel><local:LayoutGlyph Kind="Right"/><TextBlock Text="Right" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/></StackPanel></Button>
    <Button x:Name="ThirdsButton" Style="{StaticResource PresetButton}" Click="ThirdsClick" AutomationProperties.Name="Thirds placements"><StackPanel><local:LayoutGlyph Kind="Thirds"/><TextBlock Text="Thirds" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/></StackPanel></Button>
    <Button Style="{StaticResource PresetButton}" Click="FillClick" AutomationProperties.Name="Fill available space"><StackPanel><local:LayoutGlyph Kind="Fill"/><TextBlock Text="Fill" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/></StackPanel></Button>
    <Button x:Name="MoreButton" Style="{StaticResource PresetButton}" Click="MoreClick" AutomationProperties.Name="All saved placements"><StackPanel><local:LayoutGlyph Kind="More"/><TextBlock Text="More" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/></StackPanel></Button>
   </UniformGrid>
   <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,7,2,0">
    <DockPanel Height="29">
     <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Open settings" Click="SettingsClick"/>
     <Button x:Name="FooterUndoButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Undo placement (Ctrl+Z)" AutomationProperties.Name="Undo last placement" Click="UndoClick" Margin="0,0,8,0"/>
     <TextBlock x:Name="SelectionLabel" Text="Drag to place · Ctrl-click to select · Esc cancels" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
   </Border>
   <Popup x:Name="PresetsPopup" Placement="Top" StaysOpen="False" AllowsTransparency="True" Closed="PopupClosed">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6" MaxHeight="330" MinWidth="220">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PresetMenu" KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
    </Border>
   </Popup>
   <Popup x:Name="WindowStackPopup" PlacementTarget="{Binding ElementName=WindowStackButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="PopupClosed">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6" MaxHeight="350" Width="370">
     <StackPanel><TextBlock Text="WINDOWS AT THIS POINT · FRONT TO BACK" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="9,7,9,9"/><ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="WindowStackMenu" KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></StackPanel>
    </Border>
   </Popup>
   <Popup x:Name="GridPopup" PlacementTarget="{Binding ElementName=GridOptionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="PopupClosed">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
     <StackPanel><TextBlock Text="GRID SIZE" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal">
      <StackPanel><TextBlock Text="Columns" FontSize="11" Margin="0,0,0,4"/><ComboBox x:Name="ColumnsPicker" Width="86" SelectionChanged="GridDimensionsChanged" AutomationProperties.Name="Grid columns"/></StackPanel>
      <TextBlock Text="×" Margin="12,22,12,0"/><StackPanel><TextBlock Text="Rows" FontSize="11" Margin="0,0,0,4"/><ComboBox x:Name="RowsPicker" Width="86" SelectionChanged="GridDimensionsChanged" AutomationProperties.Name="Grid rows"/></StackPanel>
     </StackPanel><TextBlock x:Name="GridError" TextWrapping="Wrap" MaxWidth="216" FontSize="11" Foreground="{DynamicResource ErrorBrush}" Margin="0,6,0,0"/></StackPanel>
    </Border>
   </Popup>
  </Grid>
 </Border>
 <Border x:Name="Sidebar" Grid.Column="1" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1" CornerRadius="0,12,12,0" Padding="9,12,9,8">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Height="32" Margin="2,0,0,9">
    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE76C;" Click="ToggleSidebarClick" ToolTip="Collapse windows" AutomationProperties.Name="Collapse window sidebar"/>
    <TextBlock DockPanel.Dock="Left" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBlock DockPanel.Dock="Left" Text="Windows" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="7,2" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="WindowCount" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold"/></Border>
   </DockPanel>
   <Grid Grid.Row="1" Margin="0,0,0,8">
    <TextBox x:Name="WindowSearch" Background="{DynamicResource PanelControlBrush}" TextChanged="WindowSearchChanged" Padding="29,7,28,7" AutomationProperties.Name="Find a window" ToolTip="Search window titles or app names (Ctrl+F)"/>
    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14"/>
    <TextBlock x:Name="SearchPlaceholder" Text="Find a window…" Foreground="{DynamicResource MutedBrush}" Margin="30,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12"/>
    <Button x:Name="ClearSearchButton" Content="×" Click="ClearSearchClick" HorizontalAlignment="Right" VerticalAlignment="Center" Width="25" Padding="0" BorderThickness="0" Background="Transparent" Visibility="Collapsed" ToolTip="Clear search" AutomationProperties.Name="Clear window search"/>
   </Grid>
   <ScrollViewer x:Name="WindowScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" ScrollChanged="WindowScrollChanged" Focusable="False">
    <UniformGrid x:Name="WindowCards" Columns="2" VerticalAlignment="Top" KeyboardNavigation.DirectionalNavigation="Contained"/>
   </ScrollViewer>
   <TextBlock x:Name="NoWindowResults" Grid.Row="2" Text="No matching windows" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
   <TextBlock Grid.Row="3" Text="Click to select a window" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="3,9,0,2"/>
  </Grid>
 </Border>
 </Grid>
</Window>
