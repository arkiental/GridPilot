<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF starts the process; WinForms is used only for NotifyIcon. DPI must be declared before WPF creates HWNDs. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/GridPilot.ico</ApplicationIcon>
    <AssemblyName>GridPilot</AssemblyName>
    <Version>1.1.1</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../GridPilot.Core/GridPilot.Core.csproj" /></ItemGroup>
</Project>
